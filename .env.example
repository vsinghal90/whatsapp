# Copy to .env.local for local runs. On Vercel, add these under Project → Settings → Environment Variables.
# Never commit real values.

# From the Meta app dashboard → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
# Permanent token from a System User (Business Settings → Users → System users)
WHATSAPP_ACCESS_TOKEN=
# App dashboard → App settings → Basic → App secret
WHATSAPP_APP_SECRET=
# Any long random string you make up; paste the same value into the webhook settings
WHATSAPP_VERIFY_TOKEN=

# Your own WhatsApp number with country code, no + (gets a message for each new order)
OWNER_WHATSAPP_NUMBER=

# Optional: Claude answers free-text questions. Leave empty to use buttons only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Set automatically when you add Upstash Redis from the Vercel Marketplace
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional overrides
# MENU_SHEET_ID=1QXJNRLOuIlhww9tM2DerlbY8zYK8ITmHw21piEelAFg
# MENU_SHEET_GID=0
# MENU_CSV_URL=
# MENU_CACHE_SECONDS=600
# HUMAN_HANDOFF_MINUTES=120
# BUSINESS_NAME=Shuddh Desi Bites
# WHATSAPP_GRAPH_VERSION=v23.0
